<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- BenchmarkDotNet refuses to run a Debug build, and says so loudly.
         Naming the configuration here means a plain `dotnet run` on this
         project is a Release run. -->

    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Optimize>true</Optimize>
    <!-- The culture rows need the real ICU data. `de-DE` under an invariant
         globalization mode would silently render like the invariant culture,
         so the row would measure nothing. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- BenchmarkDotNet builds and runs a generated project per job; without
         this it warns that the assembly is not the one it expects. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- The same two packages, at the same versions, the golden harness pins.
         `SmartFormat.NET` pulls the time extension in already; naming it keeps
         the version explicit and matches the port's `time` feature. -->
    <PackageReference Include="SmartFormat.NET" Version="3.6.1" />
    <PackageReference Include="SmartFormat.Extensions.Time" Version="3.6.1" />
  </ItemGroup>

</Project>
