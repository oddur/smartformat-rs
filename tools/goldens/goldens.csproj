<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- `dotnet run` writes build diagnostics to stdout, which would corrupt
         the generated JSON, so no warning may survive a build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Culture cases need the real ICU data. The default is already false,
         but an environment that turned it on would silently render every
         culture as the invariant one instead of failing. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SmartFormat.NET" Version="3.6.1" />
    <!-- The `time` cases need TimeFormatter, which lives in its own package.
         `SmartFormat.NET` already pulls it in at the same version; naming it
         here pins the version the M4 cases were generated against. -->
    <PackageReference Include="SmartFormat.Extensions.Time" Version="3.6.1" />
  </ItemGroup>

</Project>
